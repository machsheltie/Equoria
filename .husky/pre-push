#!/usr/bin/env sh
#
# Pre-push: fast, proportionate checks only (Equoria-zstml).
#
# OWNER RULING q233 (2026-10-28): "Full check runs only on GitHub after pushes;
# laptop runs only the changed tests." The full gate — the sharded backend
# suite, the frontend suite, typecheck, lint and the whole doctrine suite —
# runs on GitHub Actions for every push to master and every PR
# (.github/workflows/test.yml, ci-cd.yml, doctrine-gate.yml). This hook never
# runs a full test suite. It replaced the full sharded backend gate
# (`npm run test:backend:full`, ~7 min, most of the laptop's memory), which
# that gate's cost had pushed everyone into skipping with --no-verify.
#
# What runs, in order, each failing closed:
#   1. session guard        scripts/session/session-guard.sh (~0.2s)
#   2. candidate state      scripts/preflight/candidate-state.mjs before
#   3. doctrine, fast mode  scripts/doctrine-checks/run-all.sh --fast (~45s);
#                           skips only the whole-tree eslint/prettier check,
#                           which step 4 replaces for the changed files
#   4. changed checks       scripts/preflight/changed-checks.mjs: eslint and
#                           prettier on the changed files, then the related
#                           backend Jest files (serial) and frontend Vitest
#                           files (2 workers), each capped
#   5. candidate state      again, so a result is never attached to a tree
#                           that was edited while the checks ran
#
# The full sharded profile is still available by hand:
#   npm run test:backend:full
# docs/devops-cicd.md ("Where each check runs") describes the split.

# Use the repo root regardless of where the hook was invoked from.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-push] FATAL: not inside a git working tree" >&2
  exit 1
fi

# git feeds a pre-push hook "<local ref> <local sha> <remote ref> <remote sha>"
# lines on stdin. stdin can be read only once, so it is captured here and
# replayed to every consumer. A terminal means a manual run: no refs.
if [ -t 0 ]; then
  PUSH_REFS=""
else
  PUSH_REFS="$(cat)"
fi

# Equoria-9ai5g: refuses a push that carries another session's commits.
printf '%s\n' "$PUSH_REFS" | sh "$REPO_ROOT/scripts/session/session-guard.sh" prepush || exit 1

# Equoria-hqrqk: the checks below read this checkout's working tree while git
# publishes the commits on stdin. Refuses when they differ, or when the push
# would be rejected as non-fast-forward.
printf '%s\n' "$PUSH_REFS" | node "$REPO_ROOT/scripts/preflight/candidate-state.mjs" before || exit 1

printf '[pre-push] Running doctrine checks (fast mode) ...\n'
if ! bash "$REPO_ROOT/scripts/doctrine-checks/run-all.sh" --fast; then
  echo "[pre-push] FATAL: doctrine-checks/run-all.sh --fast failed." >&2
  echo "[pre-push]   Fix the violations above (or add a doctrine-allow marker" >&2
  echo "[pre-push]   if the violation is intentional and documented)." >&2
  exit 1
fi

# Lint, format and tests for what this push changes. The script strips GIT_*
# from every child process (tests that spawn git in temporary directories
# would otherwise act on this repository) and refuses while another test run
# is using the machine.
if ! printf '%s\n' "$PUSH_REFS" | node "$REPO_ROOT/scripts/preflight/changed-checks.mjs"; then
  echo "[pre-push] FATAL: changed-file checks failed." >&2
  exit 1
fi

cd "$REPO_ROOT" || exit 1
printf '%s\n' "$PUSH_REFS" | node "$REPO_ROOT/scripts/preflight/candidate-state.mjs" after || {
  echo "[pre-push] FATAL: the candidate changed while the checks ran; re-run the push." >&2
  exit 1
}
