
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-specific files must have CRLF
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Native Node.js addons — mark as binary to prevent text normalization
# Fixes Windows lint-staged stash-pop failure when rollup native binary is held by a process
*.node binary

# Owner-authored design documents: store byte-for-byte, never normalise line endings
docs/features/13_Competitions_shows_Event_Scoring_DEEP.md -text
docs/features/competitiontemperamentmatrix.md -text

# Applied-migration bytes: these two migrations were applied to long-lived local
# databases from CRLF working files, and Prisma checksums raw bytes. The blobs
# stay LF; checkouts materialise CRLF so every worktree hashes to the recorded
# checksum (Equoria-k9s2h, Equoria-q9krw). Do not extend this list to other
# migrations and do not edit these files.
packages/database/prisma/migrations/20260129111928_remove_deprecated_ownerId_field/migration.sql text eol=crlf
packages/database/prisma/migrations/20260513120000_add_rider_total_competitions/migration.sql text eol=crlf
