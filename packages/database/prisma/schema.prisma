model StaffTicket {
  id         Int                @id @default(autoincrement())
  /// Null once the filing account is erased (Equoria-2yugk): "a former steward".
  filedById  String?
  filedBy    User?              @relation("StaffTicketFiler", fields: [filedById], references: [id], onDelete: SetNull)
  targetType String // user | post | horse | show
  targetId   String
  category   String
  note       String
  status     String             @default("open") // open | inProgress | resolved | declined
  replies    StaffTicketReply[]
  createdAt  DateTime           @default(now())
