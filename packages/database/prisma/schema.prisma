enum ClubType {
  discipline
  breed
}

enum ClubRole {
  member
  officer
  president
}

enum ElectionStatus {
  upcoming
  open
  closed
}

/// How a closed club election was decided (Equoria-bvddn.22, owner ruling
/// 2026-10-22: a tied election goes to a one-day run-off between the tied
/// candidates, and the run-off winner takes the seat; 2026-10-23: a tied
/// run-off opens another one-day run-off, repeating until someone wins).
enum ElectionOutcome {
  /// One candidate had the most votes; winnerCandidateId holds the seat.
  won
  /// The top vote count was tied (in an election or a run-off); `runoff` is
  /// the run-off round deciding it.
  runoff
  /// Written by nothing since the owner ruling of 2026-10-23 (a tied run-off
  /// now records `runoff` and opens another round). Kept only because dropping
  /// an enum value needs a migration.
  tied
}

model Club {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  type        ClubType
  category    String
  description String
  leaderId    String
  leader      User             @relation("ClubsLed", fields: [leaderId], references: [id])
  createdAt   DateTime         @default(now())
  members     ClubMembership[]
  elections   ClubElection[]

  /// Equoria-lffdv: the clubs a player leads (account erasure, leader checks).
  @@index([leaderId])
}

model ClubMembership {
  id       Int      @id @default(autoincrement())
  clubId   Int
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("ClubMemberships", fields: [userId], references: [id])
  role     ClubRole @default(member)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  /// Equoria-bvddn.23: the unique index above leads with clubId, so it cannot
  /// serve a by-user membership lookup; this FK index does.
  @@index([userId])
}

model ClubElection {
  id         Int               @id @default(autoincrement())
  clubId     Int
  club       Club              @relation(fields: [clubId], references: [id])
  position   String
  status     ElectionStatus    @default(upcoming)
  startsAt   DateTime
  endsAt     DateTime
  candidates ClubCandidate[] @relation("ClubCandidateToClubElection")
  /// Equoria-bvddn.22: set when the closing job decides the election; NULL
  /// while it is not closed, or when it closed with no candidates.
  outcome           ElectionOutcome?
  /// The candidate (a row of THIS election) who takes the seat. For an
  /// election decided by run-off it is set once the run-off has a winner.
  winnerCandidateId Int?
  winnerCandidate   ClubCandidate?   @relation("ElectionWinner", fields: [winnerCandidateId], references: [id], onDelete: SetNull)
  /// A run-off round points at the tied election it decides.
  runoffOfId        Int?             @unique
  runoffOf          ClubElection?    @relation("ElectionRunoff", fields: [runoffOfId], references: [id], onDelete: SetNull)
  runoff            ClubElection?    @relation("ElectionRunoff")

  /// Equoria-lffdv: a club's elections.
  @@index([clubId])
}

model ClubCandidate {
  id         Int          @id @default(autoincrement())
  electionId Int
  election   ClubElection @relation("ClubCandidateToClubElection", fields: [electionId], references: [id])
  userId     String
  user       User         @relation("ElectionCandidacies", fields: [userId], references: [id])
  statement  String
  ballots    ClubBallot[]
  /// Elections this candidacy won (Equoria-bvddn.22).
  electionsWon ClubElection[] @relation("ElectionWinner")

  @@unique([electionId, userId])
}

model ClubBallot {
  id          Int           @id @default(autoincrement())
  candidateId Int
  candidate   ClubCandidate @relation(fields: [candidateId], references: [id])
  voterId     String
  voter       User          @relation("CastBallots", fields: [voterId], references: [id])
  electionId  Int
  createdAt   DateTime      @default(now())

  @@unique([electionId, voterId])
}

model HorseSale {
  /// Unique identifier for each sale record
  id        Int      @id @default(autoincrement())
  /// Horse that was sold
  horseId   Int
  horse     Horse    @relation(fields: [horseId], references: [id])
  /// User who sold the horse
  sellerId  String
  seller    User     @relation("HorseSalesSold", fields: [sellerId], references: [id])
  /// User who bought the horse
  buyerId   String
  buyer     User     @relation("HorseSalesBought", fields: [buyerId], references: [id])
  /// Final sale price in coins
  salePrice Int
  /// Horse name snapshot at time of sale
  horseName String
  /// When the sale completed
  soldAt    DateTime @default(now())

  /// Equoria-bvddn.23: FK index for per-horse sale history.
  @@index([horseId])
  /// Equoria-cmw85.26: sale history reads one seller's or buyer's sales, newest first.
  /// Each replaces the plain single-column index it covers.
  @@index([sellerId, soldAt(sort: Desc)])
  @@index([buyerId, soldAt(sort: Desc)])
  @@index([soldAt])
  @@map("horse_sales")
}

// ── BA-1: Show lifecycle enum ──────────────────────────────────────────────────

enum ShowStatus {
  open
  closed
  executing
  completed
  /// Equoria-c7mx0.1: execution failed 3 times; never retried automatically.
