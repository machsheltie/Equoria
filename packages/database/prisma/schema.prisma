generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  /// Unique identifier for each user
  id               String            @id @default(uuid())
  /// Username used for login or display
  username         String            @unique
  /// Email address (must be unique)
  email            String            @unique
  /// Hashed password
  password         String
  /// Timestamp of last password change. CWE-613 mitigation: tokens with iat older than
  /// this value are rejected by authenticateToken. Null = no constraint (existing users
  /// who have never rotated their password — legacy sessions remain valid until natural expiry).
  passwordChangedAt DateTime?
  /// First and last name for display purposes
  firstName        String
  lastName         String
  /// Date of birth — collected at registration for COPPA age-gate enforcement
  /// (Equoria-iqzn). Server computes real-calendar age and rejects under-13
  /// registrations BEFORE this row is created, so persisted rows are always
  /// >= 13. Nullable for legacy accounts created before the age gate existed.
  /// Treated as sensitive PII: redacted from audit/request logs.
  dateOfBirth      DateTime?
  /// In-game currency (or balance)
  money            Int               @default(1000)
  /// Current level of the user
  level            Int               @default(1)
  /// Experience points toward next level
  xp               Int               @default(0)
  /// User role for access control
  role             String            @default("user")
  /// JSON object for customizable settings (theme, preferences, etc.)
  settings         Json              @default("{}")
  /// Grace period start date for groom salary payments
  groomSalaryGracePeriod DateTime?
  /// Email verification status
  emailVerified    Boolean           @default(false)
  emailVerifiedAt  DateTime?
  /// TOTP MFA (OWASP A07, Equoria-2vwwh). Opt-in. mfaSecret is the base32
  /// TOTP shared secret encrypted at rest via
  /// `backend/utils/fieldEncryption.mjs` (AES-256-GCM, key=`FIELD_ENCRYPTION_KEY`,
  /// Equoria-yi13v 2026-05-18). Plaintext appears only in-memory at the
  /// verify-enrollment / challenge / disable boundaries. Legacy
  /// pre-encryption plaintext rows are tolerated on read (decrypt-or-pass)
  /// and re-encrypted on next write — no data migration required.
  /// mfaRecoveryCodes is a JSON array of { codeHash, usedAt } objects;
  /// codes are bcrypt-hashed and single-use. mfaEnabled gates the login
  /// challenge.
  mfaSecret        String?
  mfaEnabled       Boolean           @default(false)
  mfaRecoveryCodes Json?
  /// Timestamps
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  groomAssignments        GroomAssignment[]
  groomSalaryPayments     GroomSalaryPayment[]
  grooms                  Groom[]
  /// Equoria-ypb7d: this player's groom engagements, open and closed. `grooms`
  /// above is the LIVE staff (Groom.userId); this is the history.
  groomEngagements        GroomEngagement[]
  horses                  Horse[]
  riders                  Rider[]
  riderSalaryPayments     RiderSalaryPayment[]
  riderAssignments        RiderAssignment[]
  trainers                Trainer[]
  trainerAssignments      TrainerAssignment[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  transactions            UserTransaction[]
  shows                   Show[]
  xpEvents                XpEvent[]
  facilities              Facility[]
  emailVerificationTokens EmailVerificationToken[]
  forumThreads            ForumThread[]            @relation("ForumThreads")
  forumPosts              ForumPost[]              @relation("ForumPosts")
  sentMessages            DirectMessage[]          @relation("SentMessages")
  receivedMessages        DirectMessage[]          @relation("ReceivedMessages")
  clubsLed                Club[]                   @relation("ClubsLed")
  clubMemberships         ClubMembership[]         @relation("ClubMemberships")
  candidacies             ClubCandidate[]          @relation("ElectionCandidacies")
  ballots                 ClubBallot[]             @relation("CastBallots")
  hallOfFameNominations   HallOfFameNomination[]   @relation("HallOfFameNominations")
  hallOfFameVotes         HallOfFameVote[]         @relation("HallOfFameVotes")
  horsesSold              HorseSale[]              @relation("HorseSalesSold")
  horsesBought            HorseSale[]              @relation("HorseSalesBought")
  showsCreated            Show[]                   @relation("ShowCreator")
  showEntries             ShowEntry[]              @relation("ShowEntries")
  /// Equoria-r9q06: the results this player entered, whoever owns the horse now.
  competitionResultsEntered CompetitionResult[]   @relation("CompetitionResultEntrant")
  staffMarketplaceStates  StaffMarketplaceState[]
  notifications             Notification[]
  monthlyTotals             PlayerMonthlyTotal[]
  staffCheckinCodes         StaffCheckinCode[]
  staffTrustedDevices       StaffTrustedDevice[]
  staffTicketsFiled         StaffTicket[]          @relation("StaffTicketFiler")
  staffTicketReplies        StaffTicketReply[]     @relation("StaffTicketReplyAuthor")
  emailOutbox               EmailOutbox[]
  breedingRecordsAsMareOwner     BreedingRecord[]  @relation("BreedingRecordsAsMareOwner")
  breedingRecordsAsStallionOwner BreedingRecord[]  @relation("BreedingRecordsAsStallionOwner")
  /// Equoria-wbt8l: News posts this account wrote at the News Desk.
  newsItemsAuthored              NewsItem[]        @relation("NewsItemAuthor")
  /// Equoria-w47x7: this player's conduct record and where they have signed in from.
  conductRecords                 ConductRecord[]
  loginSightings                 LoginSighting[]

  @@index([email])
  @@index([emailVerified])
  /// Equoria-y3nia: the Overall player XP board orders by xp.
  @@index([xp])
  /// Equoria-cmw85.36: the player search is a case-insensitive prefix match, which
  /// the plain unique index above cannot serve. A trigram index can (needs the
  /// pg_trgm extension, created by the migration).
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  isRead    Boolean  @default(false)
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model Breed {
  /// Unique identifier for each breed
  id                  Int     @id @default(autoincrement())
  /// Name of the breed (unique constraint required for ON CONFLICT upserts)
  name                String  @unique
  /// Description of the breed
  description         String?
  /// Optional default trait associated with the breed
  defaultTrait        String?
  /// JSONB containing ratingProfiles (conformation, gaits, gaited config) and temperamentWeights
  breedGeneticProfile Json?
  horses              Horse[]

  @@map("breeds")
}

model Stable {
  /// Unique identifier for each stable
  id       Int     @id @default(autoincrement())
  /// Name of the stable
  name     String
  /// Location of the stable
  location String?
  horses   Horse[]

  @@map("stables")
}

model Horse {
  /// Unique identifier for each horse
  id                      Int                   @id @default(autoincrement())
  /// Name of the horse
  name                    String
  /// Sex of the horse
  sex                     String
  /// Date of birth
  dateOfBirth             DateTime              @db.Date
  /// Foreign keys
  breedId                 Int?
  stableId                Int?
  /// Coat color genetics (Epic 31E)
  colorGenotype           Json?                 // Allele pairs per locus: { E_Extension: "E/e", ... }
  phenotype               Json?                 // Calculated phenotype: { colorName, shade, markings, ... }. The one source of a horse's color and markings.
  shade                   String?
  imageUrl                String?               @default("/images/samplehorse.JPG")
  /// Traits and characteristics
  trait                   String?
  temperament             String?
  personality             String?
  /// Epigenetic trait flags for horses under 3 years old (PERMANENT once assigned)
  epigeneticFlags         String[]              @default([])
  /// Temporary / environment-triggered epigenetic flags (Equoria-yzqhj.5).
  /// JSON array of { flag: string, expiresAt: ISO-string, source: string }.
  /// Expired entries are swept daily by the temporaryFlagExpiry cron.
  temporaryEpigeneticFlags Json                 @default("[]")
  /// Base stats
  /// Equoria-507mt: NOT NULL post-migration 20260530130000_507mt_horse_stats_nonnull.
  /// 0 NULLs observed pre-migration. Companion code commits strip the
  /// `?? 50` / `?? 0` reader-side defaults that pretended NULL was possible.
  precision               Int                   @default(0)
  strength                Int                   @default(0)
  speed                   Int                   @default(0)
  agility                 Int                   @default(0)
  endurance               Int                   @default(0)
  intelligence            Int                   @default(0)
  /// Additional competition stats
  stamina                 Int                   @default(0)
  balance                 Int                   @default(0)
  boldness                Int                   @default(0)
  flexibility             Int                   @default(0)
  obedience               Int                   @default(0)
  focus                   Int                   @default(0)
  /// Financial and breeding
  totalEarnings           Int                   @default(0)
  sireId                  Int?
  damId                   Int?
  studStatus              String?               @default("Not at Stud")
  studFee                 Int?                  @default(0)
  lastBredDate            DateTime?             @db.Date
  /// In-foal state (Phase B — feed-system pregnancy mechanic)
  inFoalSinceDate         DateTime?
  pregnancySireId         Int?
  pregnancyFeedingsByTier Json                  @default("{}")
  pendingFoalName         String?
  pendingFoalBreedId      Int?
  forSale                 Boolean?              @default(false)
  salePrice               Int?                  @default(0)
  /// Health and care
  healthStatus            String?               @default("Excellent")
  lastVettedDate          DateTime?             @default(now()) @db.Date
  /// Veterinarian Genetic Testing panel bought (owner ruling 2026-10-26, Equoria-7dmzp). Equoria-8tz7p reveals colour genetics once true.
  colorGeneticsTested     Boolean               @default(false)
  /// Equoria-507mt: bond + grooming/foal counters NOT NULL too.
  /// bondScore default stays 0 (unbonded — per user decision: bond is earned, not innate).
  bondScore               Int                   @default(0)
  /// Groom bonding: consecutive-day care streak
  daysGroomedInARow       Int                   @default(0)
  /// Foal task logging and streak tracking
  taskLog                 Json?
  consecutiveDaysFoalCare Int                   @default(0)
  lastGroomed             DateTime?
  /// Game mechanics
  tack                    Json?                 @default("{}")
  age                     Int?
  userId                  String?
  trainingCooldown        DateTime?
  // Equoria-8nmxm: Horse.earnings (Decimal) removed by migration
  // 20260529150000_8nmxm_drop_horse_earnings_column. The Int column
  // `totalEarnings` (declared earlier in this model) is the canonical
  // earnings counter and is what the leaderboards / horseController /
  // frontend all read. The writer in backend/utils/horseUpdates.mjs was
  // re-aimed at totalEarnings in the same commit.
  // Equoria-97se: the `rider` JSON copy is gone (migration
  // 20261026140100_drop_dead_horse_columns_and_prefix_indexes); the active
  // RiderAssignment row is the only record of who rides a horse.
  disciplineScores        Json?
  epigeneticModifiers     Json?                 @default("{\"hidden\": [], \"negative\": [], \"positive\": []}")
  /// Ultra-rare and exotic traits with acquisition metadata
  ultraRareTraits         Json?                 @default("{\"ultraRare\": [], \"exotic\": []}")
  /// Conformation scoring (1-100 scale per body region)
  conformationScores      Json?                 @default("{\"head\": 20, \"neck\": 20, \"shoulders\": 20, \"back\": 20, \"legs\": 20, \"hooves\": 20, \"topline\": 20, \"hindquarters\": 20, \"overallConformation\": 20}")
  /// Gait quality scores (permanent, generated at birth)
  gaitScores              Json?
  /// Horse XP System (Equoria-507mt: NOT NULL)
  horseXp                 Int                   @default(0)
  availableStatPoints     Int                   @default(0)
  /// Farrier: the one weekly "Shoe horse" action records this date (owner
  /// ruling 2026-10-23, Equoria-zmqzf). lastFarrierDate and hoofCondition were
  /// dropped by migration 20261023220000_farrier_one_action_rider_retirement.
  lastShod                DateTime?
  /// Feed Shop fields (redesign 2026-04-29)
  equippedFeedType        String?
  lastFedDate             DateTime?
  /// Hunger clock (owner ruling 2026-10-23): the instant hunger days count from. Null = lastFedDate. A feeding below Excellent back-dates it so one feeding raises hunger one level.
  hungerSince             DateTime?
  /// Conformation show title progression (Epic 31F-3)
  titlePoints             Int                   @default(0)
  currentTitle            String?
  breedingValueBoost      Float                 @default(0.0)
  /// Timestamps
  createdAt               DateTime?             @default(now())
  updatedAt               DateTime?             @updatedAt
  competitionResults      CompetitionResult[]
  foalActivities          FoalActivity[]
  foalDevelopment         FoalDevelopment?      @relation("FoalDevelopmentFoal")
  foalTrainingHistory     FoalTrainingHistory[]
  groomAssignments        GroomAssignment[]
  groomInteractions       GroomInteraction[]
  horseXpEvents           HorseXpEvent[]
  monthlyTotals           HorseMonthlyTotal[]
  traitHistoryLogs        TraitHistoryLog[]
  milestoneTraitLogs      MilestoneTraitLog[]
  ultraRareTraitEvents    UltraRareTraitEvent[]
  groomHorseSynergies     GroomHorseSynergy[]
  groomAssignmentLogs     GroomAssignmentLog[]
  riderAssignments        RiderAssignment[]
  trainerAssignments      TrainerAssignment[]
  breed                   Breed?                @relation(fields: [breedId], references: [id])
  /// Equoria-v58ta: onDelete: Restrict on userId/sireId/damId. The
  /// owner relation (user) and breeding lineage (dam/sire) MUST refuse
  /// to delete the parent silently — callers must explicitly delete
  /// owned horses / descendants first, surfacing stale ownership rather
  /// than orphaning rows. See migration
  /// 20260530120000_v58ta_horse_restrict_fks.
  dam                     Horse?                @relation("DamLineage", fields: [damId], references: [id], onDelete: Restrict)
  damOffspring            Horse[]               @relation("DamLineage")
  sire                    Horse?                @relation("SireLineage", fields: [sireId], references: [id], onDelete: Restrict)
  sireOffspring           Horse[]               @relation("SireLineage")
  stable                  Stable?               @relation(fields: [stableId], references: [id])
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  trainingLogs            TrainingLog[]
  horseSales              HorseSale[]
  showEntries             ShowEntry[]
  breedingRecordsAsSire   BreedingRecord[]      @relation("BreedingRecordSire")
  breedingRecordsAsDam    BreedingRecord[]      @relation("BreedingRecordDam")
  breedingRecordAsFoal    BreedingRecord?       @relation("BreedingRecordFoal")
  hallOfFameNomination    HallOfFameNomination?
  hallOfFameInduction     HallOfFameInduction?

  @@index([userId])
  @@index([breedId])
  @@index([stableId])
  /// Equoria-y3nia: the Overall horse points and earnings boards.
  @@index([horseXp])
  @@index([totalEarnings])
  /// Equoria-cmw85.24: the daily foaling job picks the mares in foal. The column is
  /// NULL for almost every horse, so this index is tiny.
  @@index([inFoalSinceDate])
  /// Equoria-ezx1y: indexes for high-traffic WHERE-filter queries.
  /// - sireId  → backend/modules/users/services/gdprAccountService.mjs:286
  ///   (cascade `prisma.horse.updateMany({ where: { sireId: { in: horseIds } } })`)
  /// - damId   → backend/modules/users/services/gdprAccountService.mjs:282
  ///   (same shape for the dam side; also backend/tests/load/run-bulk-foaling-cron.mjs)
  /// - forSale + salePrice composite →
  ///     backend/modules/marketplace/controllers/marketplaceController.mjs:60
  ///   (browseListings: `where: { forSale: true, userId: { not: userId } }`
  ///    + `orderBy: { salePrice: 'asc' | 'desc' }`). The composite serves
  ///   both the leading-column filter AND the sort, so a separate
  ///   `@@index([forSale])` would be redundant.
  @@index([sireId])
  @@index([damId])
  @@index([forSale, salePrice])
  /// Equoria-qh6jk / Equoria-mxftz / Equoria-69gip — the sixteen `idx_horses_*`
  /// indexes that exist on `horses` IN MIGRATION HISTORY are created in raw SQL
  /// by migration 20260528120000_qh6jk_align_runtime_indexes, which recorded
  /// indexes that backend/services/databaseOptimizationService.mjs had been
  /// creating with `CREATE INDEX IF NOT EXISTS` outside migration history:
  ///
  ///   idx_horses_age_and_training_status, idx_horses_breedid_age,
  ///   idx_horses_discipline_scores_filter, idx_horses_discipline_scores_gin,
  ///   idx_horses_disciplinescores_gin, idx_horses_epigenetic_flags_gin,
  ///   idx_horses_epigenetic_flags_search, idx_horses_epigeneticflags_gin,
  ///   idx_horses_epigeneticmodifiers_gin, idx_horses_ownerid_stableid,
  ///   idx_horses_stats_gin, idx_horses_ultrararetraits_gin,
  ///   idx_horses_userid_age, idx_horses_userid_age_trainingcooldown,
  ///   idx_horses_userid_breedid, idx_horses_userid_createdat
  ///
  /// SIX OF THOSE SIXTEEN ARE GONE AS OF Equoria-bebob. Migration
  /// 20260915120000_bebob_drop_redundant_horse_indexes drops five exact
  /// duplicates and one prefix-redundant index under the owner's ruling of
  /// 2026-09-14 — see that file for the measured before/after and the surviving
  /// twin of each dropped name. ELEVEN OF THE SURVIVORS ARE DECLARED BELOW,
  /// each with `map:` pinning the name the migration already created, so Prisma
  /// adopts the existing index rather than proposing to drop it or to create a
  /// differently-named one. The counts in this block are stated as of that
  /// migration; the raw list above is the qh6jk history, which is not rewritten.
  ///
  /// DECLARATION IS THE REMEDY, AND IT REPLACES THE OLD ONE. Until 2026-09-09
  /// this block told the reader to delete the generated `DROP INDEX` statements
  /// from the migration by hand. That was the wrong remedy and the weakest
  /// control available: it only works if someone opens a file they have no
  /// reason to open, it has to be re-performed correctly every single time, it
  /// rots the moment the index set changes, and nothing checks that it happened.
  /// Worse, `prisma migrate dev` generates AND applies in one step, so the
  /// indexes are already gone from the developer's database by the time anyone
  /// could review the file. Declaring the indexes removes the hazard at its
  /// source: the destructive statement is never generated, so there is nothing
  /// to accept and nothing to hand-edit. Do not reintroduce the hand-edit
  /// instruction.
  ///
  /// Measured 2026-09-09, read-only, no migration and no DDL, BEFORE the
  /// Equoria-bebob drops, with
  /// `prisma migrate diff --from-schema-datasource <schema>
  /// --to-schema-datamodel <schema> --script` against the local `equoria`
  /// database. With the twelve declarations below plus
  /// `user_transactions_user_created_idx` (see UserTransaction) and
  /// `SystemAccount.updatedAt @default(now())` (see SystemAccount), the whole
  /// proposal collapses from 17 `DROP INDEX` + 1 `ALTER COLUMN` to
  /// `-- This is an empty migration.` Nothing is added, because name, columns,
  /// access method and operator class all match what qh6jk created. All
  /// fourteen items were then re-planted as defects — deleted one at a time —
  /// and every one fired: for the eleven declarations that cover a single shape
  /// (ten below plus the ledger index), exactly its own `DROP INDEX` returned;
  /// for the two that cover a duplicate group, the group's three returned
  /// together; and for the `SystemAccount` default, the `ALTER COLUMN`.
  ///
  /// DUPLICATE GROUPS — why four names are deliberately NOT declared. The
  /// database holds three identically-defined GIN indexes on `disciplineScores`
  /// and three on `epigeneticFlags`. Prisma's differ matches an index by SHAPE
  /// (table, columns, access method, operator class), NOT one-to-one by name:
  /// measured across all eight subsets of each group, ONE declaration suppresses
  /// the `DROP INDEX` for all three whichever name it pins, and zero
  /// declarations proposes all three. So only each group's surviving name is
  /// declared — `idx_horses_discipline_scores_filter` and
  /// `idx_horses_epigenetic_flags_gin`. Declaring all six would reach the same
  /// empty migration but would make every FRESH database create nine GIN indexes
  /// on `horses` instead of five, propagating the accident; and it would fight
  /// Equoria-bebob, whose migration drops the duplicates. The four left
  /// undeclared are `idx_horses_discipline_scores_gin`,
  /// `idx_horses_disciplinescores_gin`, `idx_horses_epigenetic_flags_search`
  /// and `idx_horses_epigeneticflags_gin`. They exist because
  /// databaseOptimizationService names an index from the caller's LABEL while
  /// resolving the column through an aliasing map, so two labels for one column
  /// manufacture two identical indexes. Their coverage depends on the sibling
  /// declaration staying put: delete `idx_horses_discipline_scores_filter` below
  /// and all three `disciplineScores` DROPs return together. Shape-matching is
  /// measured behaviour on Prisma 6.8.2, not a documented guarantee.
  ///
  /// AS OF Equoria-bebob all four of those undeclared duplicates are DROPPED,
  /// so each group is now one index — the declared survivor. The declarations
  /// that remain are still load-bearing for the differ; do not delete them.
  ///
  /// AS OF Equoria-34dad (owner decision 32) the three never-used GIN indexes
  /// idx_horses_epigeneticmodifiers_gin, idx_horses_stats_gin and
  /// idx_horses_ultrararetraits_gin are DROPPED by migration
  /// 20261023213000_drop_unused_horse_gin_indexes and no longer declared.
  ///
  /// THE ONE DECLARED DELETION CANDIDATE HAS BEEN DELETED.
  /// `idx_horses_userid_age` was a strict leading prefix of
  /// `idx_horses_userid_age_trainingcooldown`, so it carried no query value —
  /// but it was a distinct SHAPE, so it was the one redundant index the differ
  /// did propose dropping, and declaring it was the only way to reach an empty
  /// proposal while it still existed. Equoria-bebob dropped it in the migration
  /// and removed its `@@index([userId, age], map: "idx_horses_userid_age")`
  /// declaration in the same commit, which is why neither appears below. Do not
  /// re-add the declaration: it would propose recreating the index.
  ///
  /// SIXTEEN WAS THE MIGRATION-HISTORY COUNT, NOT THE DATABASE COUNT, and both
  /// counts moved with Equoria-bebob: history now produces TEN of the sixteen
  /// (the migration's six DROPs run after qh6jk's CREATEs), and every database
  /// carries exactly those ten. Before the drops the local development database
  /// had SEVENTEEN `idx_horses_*` indexes: the sixteen above plus
  /// `idx_horses_user_horse_lookup ("userId")`, which lived in no migration at
  /// all because backend/services/databaseOptimizationService.mjs created it at
  /// RUNTIME with `CREATE INDEX IF NOT EXISTS` — the same drift qh6jk existed to
  /// end, for one index it did not record. Verified against the local `equoria`
  /// database on 2026-09-09 with `SELECT indexname FROM pg_indexes WHERE
  /// tablename='horses' AND indexname LIKE 'idx_horses%'`.
  ///
  /// THE SEVENTEENTH IS GONE AND CANNOT COME BACK (Equoria-9xa92). It could
  /// never be owned through this file: it is structurally identical to
  /// `@@index([userId])` above, so the differ already considered it accounted
  /// for — it was never proposed for DROP, and declaring it changed the proposal
  /// by exactly nothing (measured, Equoria-69gip). Equoria-hgeaj states the
  /// opposite — that `migrate dev` will propose dropping it alongside the
  /// others — and that is WRONG; do not chase it. The only lever was removing
  /// the code that created it, and that is what Equoria-9xa92 did:
  /// `createOptimizedIndexes` had no route, controller, cron or startup caller,
  /// so "created at runtime" meant the test suite issuing DDL against the
  /// shared development database. The function and its label-to-column aliasing
  /// map — the mechanism that manufactured the duplicate names in the first
  /// place — are deleted, and the runtime-index allow-list in
  /// scripts/preflight/schema-drift.mjs is now empty, so any index outside
  /// migration history is drift with no exception. A count other than ten is
  /// something to investigate, not to tolerate.
  ///
  /// The ONE index shape Prisma cannot express is a PARTIAL index (`WHERE …`),
  /// and that limitation is harmless, because the differ cannot see a partial
  /// index to drop it either. See the three ACTIVE-only partial unique indexes
  /// on the staff-assignment tables (Equoria-kccmt; see RiderAssignment /
  /// TrainerAssignment / GroomAssignment) — verified by isolating the single
  /// variable: two unique indexes on one table differing ONLY in a `WHERE`
  /// predicate, where the plain one was proposed for DROP and the partial one
  /// was ignored. Those three are additionally guarded by
  /// backend/__tests__/scripts/freshDbMigrationReplay.sentinel.test.mjs.
  /// Everything else in this set IS expressible on Prisma 6.8.2 with no
  /// `previewFeatures`: GIN access methods (`type: Gin`), array and jsonb
  /// operator classes, composite column order, `sort: Desc`, and two indexes
  /// over identical columns under different names.
  @@index([age, trainingCooldown], map: "idx_horses_age_and_training_status")
  @@index([breedId, age], map: "idx_horses_breedid_age")
  @@index([userId, stableId], map: "idx_horses_ownerid_stableid")
  @@index([userId, age, trainingCooldown], map: "idx_horses_userid_age_trainingcooldown")
  @@index([userId, breedId], map: "idx_horses_userid_breedid")
  @@index([userId, createdAt], map: "idx_horses_userid_createdat")
  @@index([disciplineScores], map: "idx_horses_discipline_scores_filter", type: Gin)
  @@index([epigeneticFlags(ops: ArrayOps)], map: "idx_horses_epigenetic_flags_gin", type: Gin)
  @@map("horses")
}

model Groom {
  /// Unique identifier for each groom
  id                Int                @id @default(autoincrement())
  /// Name of the groom
  name              String
  /// Speciality area
  speciality        String
  /// Experience points for progression system
  experience        Int                @default(0)
  /// Skill level
  skillLevel        String             @default("novice")
  /// Star level (owner ruling 2026-10-28, Equoria-nawn5): rookie | novice | intermediate |
  /// advanced | expert (1-5 stars). Drawn once when the game generates the groom; the
  /// price comes from it (backend/constants/staffLevels.mjs). The allowed words are a CHECK
  /// constraint in migration 20261028120000_staff_star_levels.
  starLevel         String             @default("rookie")
  /// Canonical groom personality (gentle | energetic | patient | strict).
  /// Used by groom synergy (Epic 31D-4), temperament compatibility,
  /// groomPersonalityEffects, getTemperamentGroomSynergy(), and
  /// trait-development bonuses. THIS is the user-facing personality.
  /// Equoria-4ukc: consolidation deferred — semantically distinct from
  /// epigeneticInfluenceType (see below).
  personality       String
  /// Epigenetic trait-influence type (balanced | calm | energetic | gentle |
  /// methodical | confident | ...). Used by enhancedMilestoneEvaluation,
  /// groomPersonalityTraits, flagAssignmentEngine, and the trait-influence
  /// trait-discovery pipeline. Distinct semantic from `personality`:
  /// `personality` drives interaction synergy/care quality; this field drives
  /// which epigenetic traits a groom imprints onto a foal. Defaults to
  /// 'balanced' so legacy grooms have a safe no-op behavior.
  /// Equoria-4ukc: kept separate after audit — both fields are live and read
  /// by independent subsystems.
  epigeneticInfluenceType  String             @default("balanced")
  /// Bonus trait map for rare trait acquisition (JSON object with trait names and probability bonuses)
  bonusTraitMap     Json               @default("{}")
  /// Rare trait booster perks for ultra-rare and exotic traits (JSON object with perk definitions)
  rareTraitPerks    Json               @default("{}")
  /// Session rate (per session, not hourly)
  sessionRate       Decimal            @default(15.0) @db.Decimal(10, 2)
  /// Availability schedule
  availability      Json               @default("{}")
  /// Biography
  bio               String?
  /// Image URL
  imageUrl          String?
  /// Active status
  isActive          Boolean            @default(true)
  /// Show-handling skill rating used by Epic 31F conformation show scoring
  /// (handler weight: 20%). Values: novice | competent | skilled | expert | master.
  /// Mapped to a 0-100 score in conformationShowService.SHOW_HANDLING_SKILL_SCORES.
  /// Backed by migration 20260403000000_add_groom_show_handling_skill. The DB
  /// column name is the camelCase string "showHandlingSkill" (matching the
  /// migration SQL), so no @map is required.
  showHandlingSkill String             @default("novice")
  /// Hire date
  hiredDate         DateTime           @default(now())
  /// Career progression tracking
  careerWeeks       Int                @default(0)
  /// Equoria-ypb7d — the age this groom was when they entered the game, drawn
  /// once, uniformly from 18..24 inclusive, and never recomputed.
  ///
  /// The groom's CURRENT age is `startAge + careerWeeks`. `careerWeeks` already
  /// advances by one per weekly career pass, and one weekly pass is one
  /// game-year on Equoria's clock (1 real week = 1 game-year — see
  /// backend/utils/horseAge.mjs, which horses age on). So this column supplies
  /// the offset that counter was missing; it does NOT introduce a second age
  /// counter or a second clock. Read it through
  /// `groomAgeService.groomAgeYears()` rather than adding the two by hand.
  ///
  /// NULLABLE because migration 20260909120000_ypb7d_groom_age_and_engagement
  /// performs no backfill; the weekly career pass draws one idempotently
  /// (`ensureStartAge`). A groom with a NULL startAge has no known age and is
  /// therefore NOT retired by the age rule until that pass has run.
  ///
  /// NOT SECRET — unlike `retirementSchedule` below. This is a character
  /// attribute like `personality` or `bio`; only the RETIREMENT age is hidden.
  /// The range 18..24 is also enforced by the `grooms_start_age_range` CHECK
  /// constraint, which Prisma cannot express — see that migration's NOTES.md.
  startAge          Int?
  /// Equoria-ypb7d — the start of the pay week (Monday 00:00 UTC, see
  /// groomSalaryService.getPayWeekStart) whose weekly fee the engaging player
  /// could not pay.
  ///
  /// NULL  = the engagement is paid up.
  /// SET   = the groom is inside the player's one-week grace period: still on
  ///         that player's staff, but barred from grooming
  ///         (`checkGroomMayWork` in groomEngagementService.mjs).
  ///
  /// When a STRICTLY LATER pay week arrives with this still set, a full week
  /// has gone unpaid and the weekly fee pass releases the groom to the
  /// grooms-for-hire pool. Cleared the moment the fee is paid.
  feeUnpaidSince    DateTime?
  /// Retirement status
  retired           Boolean            @default(false)
  /// Reason for retirement
  retirementReason  String?
  /// When the groom retired
  retirementTimestamp DateTime?
  /// Equoria-ypb7d — the player whose STAFF this groom is currently on. This is
  /// an ENGAGEMENT, not ownership: per the owner's ruling of 2026-09-09,
  /// "players never own grooms. If anyone owns them, Equoria does. They are free
  /// agents." NULL therefore means free agent, and a groom released for
  /// non-payment has this set back to NULL so any player may hire them.
  ///
  /// It stays the LIVE pointer (the roster cap counts it, `requireOwnership`
  /// resolves it, and ~20 reads select it); `GroomEngagement` is its HISTORY, in
  /// the same relationship `GroomAssignmentLog` has to `GroomAssignment`.
  ///
  /// Retirement deliberately does NOT clear it — a retired groom is excluded
  /// from work and from the hire pool by `retired`, and keeping the pointer is
  /// what lets a player still read their retired grooms
  /// (`getRetirementStatistics`, `getUserGrooms`).
  userId            String?
  /// Timestamps
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  groomAssignments    GroomAssignment[]
  groomInteractions   GroomInteraction[]
  groomSalaryPayments GroomSalaryPayment[]
  traitHistoryLogs    TraitHistoryLog[]
  milestoneTraitLogs  MilestoneTraitLog[]
  ultraRareTraitEvents UltraRareTraitEvent[]
  groomHorseSynergies GroomHorseSynergy[]
  groomAssignmentLogs GroomAssignmentLog[]
  /// Equoria-mwjst: conformation entries this groom presents at settlement.
  showEntries         ShowEntry[]
  groomTalentSelections GroomTalentSelections?
  /// Equoria-m9lz1: the game's HIDDEN retirement schedule for this groom.
  /// Deliberately a separate table, not a column on `grooms`: the retirement
  /// age must not be discoverable until the week it takes effect, and a
  /// scalar column would be returned by every bare
  /// `prisma.groom.findMany()` / `findUnique()` in the codebase (there are
  /// ~20 such reads, several of which serialize the whole row to the player).
  /// As a relation it is structurally absent from every groom response unless
  /// a caller explicitly `include`s it — which only the retirement service does.
  /// DO NOT add `include: { retirementSchedule: true }` to a player-facing read.
  retirementSchedule  GroomRetirementSchedule?
  /// The groom's hidden growth profile (owner rulings 2026-10-28, q160/q177; Equoria-xlw03).
  /// Its own table so no groom read can serialise the unrevealed items.
  growthProfile       GroomGrowthProfile?
  /// Equoria-ypb7d: the record of every player who has hired this groom. At most
  /// one row has `endedAt = null` (partial unique index).
  engagements         GroomEngagement[]
  retiredGroomLegacies GroomLegacyLog[] @relation("RetiredGroomLegacy")
  legacyGroomMentors  GroomLegacyLog[] @relation("LegacyGroomMentor")
  user                User?              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([experience])
  @@index([careerWeeks])
  @@index([retired])
  @@index([retired, careerWeeks])
  @@map("grooms")
}

/// Equoria-m9lz1 — the game's hidden retirement schedule for one groom.
///
/// The owner's ruling (2026-09-08): "Grooms retire automatically at a randomly
/// selected age by the game. They can retire any time between age 50-65 and
/// that is not known until the week they retire."
///
/// WHY A TABLE AND NOT A COLUMN ON `grooms`
///   The hiding requirement is the whole point. A scalar on `grooms` would be
///   emitted by every bare `prisma.groom.findMany()` / `findUnique()` in the
///   repository, and several of those responses are serialized straight to the
///   player (groomRosterController, groomHandlerController,
///   horseOverviewController, gdprAccountService, …). A 1:1 relation is absent
///   from all of them by construction: Prisma returns a relation only when the
///   caller explicitly `include`s or `select`s it. The single reader is
///   backend/modules/grooms/services/groomRetirementService.mjs.
///
/// WHAT `retirementAge` IS MEASURED IN
///   The same unit as `Groom.careerWeeks` — one tick per weekly career
///   progression pass, which on Equoria's clock (1 real week = 1 game-year;
///   see backend/utils/horseAge.mjs) is one game-year of the groom's working
///   life. It replaces the old fixed `MANDATORY_RETIREMENT_WEEKS = 104`
///   threshold with a per-groom value drawn once from 50..65 inclusive.
///
/// RANGE ENFORCEMENT
///   `retirementAge BETWEEN 50 AND 65` is a CHECK constraint created in raw SQL
///   by migration 20260908180000_m9lz1_groom_retirement_schedule. Prisma cannot
///   express a CHECK constraint, so it lives only in that migration — the same
///   posture 20260907120000_kccmt_partial_unique_active_staff_assignments took
///   for its partial unique indexes. Do not "restore" it here.
///
/// OPERATOR NOTES, AND WHY THEY ARE NOT IN THE MIGRATION
///   That migration has been applied, so its bytes are load-bearing: Prisma
///   hashes the raw file and editing it — comments included — breaks
///   `prisma migrate dev` for every database that applied the old bytes. Apply
///   instructions, the per-environment status and the "never edit this" rule
///   therefore live in the migration directory's sibling `NOTES.md`, which
///   Prisma does not read. Read that before touching the migration.
model GroomRetirementSchedule {
  /// One schedule per groom; the groom id IS the primary key.
  groomId       Int      @id
  /// The career age at which the game retires this groom. Drawn once,
  /// uniformly at random from [50, 65] inclusive, and never recomputed.
  retirementAge Int
  /// When the schedule was drawn (at hire for grooms hired after Equoria-m9lz1;
  /// at the first weekly career pass for grooms that predate it).
  assignedAt    DateTime @default(now())

  groom         Groom    @relation(fields: [groomId], references: [id], onDelete: Cascade)

  @@map("groom_retirement_schedules")
}

/// Equoria-ypb7d — one player's engagement of one groom.
///
/// The owner's ruling (2026-09-09): "players never own grooms. If anyone owns
/// them, Equoria does. They are free agents. They are HIRED by players and
/// charged a weekly fee. ... If they fail to pay for a groom for a week, the
/// groom goes back to the Grooms for hire section of the marketplace and can be
/// hired by other players."
///
/// WHAT THIS TABLE IS, AND WHAT IT IS NOT
///   It is the HISTORY of who has hired whom — the same relationship
///   `GroomAssignmentLog` has to `GroomAssignment`. It is NOT the live pointer:
///   that stays `Groom.userId`, because the roster cap counts it,
///   `requireOwnership('groom')` resolves it, and roughly twenty reads select
///   it. Splitting the live state would have created a dual-write obligation on
///   every hire and release, which is a defect this repository has paid for
///   before. So: `Groom.userId` says who the groom works for now; this table
///   says who they have worked for, and why each engagement ended.
///
/// THE INVARIANT
///   A groom works for at most ONE player at a time, enforced by the partial
///   unique index `groom_engagements_active_groomId_key ... WHERE "endedAt" IS
///   NULL` in migration 20260909120000_ypb7d_groom_age_and_engagement. Prisma
///   cannot express a partial unique index, so it lives only in that raw SQL —
///   the same posture 20260907120000_kccmt_partial_unique_active_staff_assignments
///   took. Do not "restore" it here.
///
///   Alongside it, for a groom that is not retired:
///     `Groom.userId IS NOT NULL`  <=>  an open engagement row exists.
///   Retirement is the deliberate exception: it closes the engagement but leaves
///   `Groom.userId` set, so the player can still read their retired grooms.
///
/// NO BACKFILL
///   The 101 grooms that predate this table have none. `ensureEngagement` opens
///   one idempotently the first time the weekly fee pass bills a groom that
///   already carries a `userId`, exactly as `ensureRetirementSchedule` does for
///   the retirement age.
model GroomEngagement {
  id        Int       @id @default(autoincrement())
  groomId   Int
  userId    String
  /// When this player hired the groom.
  startedAt DateTime  @default(now())
  /// NULL while the engagement is live. Set when the groom leaves this player.
  endedAt   DateTime?
  /// Why it ended. Written by the game, never by a request:
  ///   'feeUnpaid' — a full pay week went unpaid; released to the hire pool.
  ///   'retirement' — the groom aged out (see groomRetirementService).
  endReason String?

  groom     Groom     @relation(fields: [groomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groomId])
  @@index([userId])
  @@map("groom_engagements")
}

model GroomAssignment {
  /// Unique identifier for each assignment
  id                Int                @id @default(autoincrement())
  /// Assignment period
  startDate         DateTime           @default(now())
  endDate           DateTime?
  /// Status flags
  isActive          Boolean            @default(true)
  isDefault         Boolean            @default(false)
  /// Bond score between groom and foal (0-100)
  bondScore         Int                @default(0)
  /// Foreign keys
  foalId            Int
  groomId           Int
  userId            String?
  /// Timestamps
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  foal              Horse              @relation(fields: [foalId], references: [id], onDelete: Cascade)
  groom             Groom              @relation(fields: [groomId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  groomInteractions GroomInteraction[]

  /// Equoria-kccmt: see the RiderAssignment note. The one-active-assignment-
  /// per-(groom, horse) rule is the partial unique index
  /// `groom_assignments_active_foalId_groomId_key ... WHERE "isActive"`,
  /// created in raw SQL by migration
  /// 20260907120000_kccmt_partial_unique_active_staff_assignments.
  /// Equoria-cmw85.35: the plain [foalId] index was kept off the drop list because the only
  /// other foalId-leading index is the ACTIVE-only partial unique, which cannot serve
  /// history reads.
  @@index([foalId])
  @@index([groomId])
  /// Equoria-cmw85.25: "My grooms", salary and stats read one player's assignments.
  @@index([userId, createdAt(sort: Desc)])
  @@map("groom_assignments")
}

model GroomInteraction {
  /// Unique identifier for each interaction
  id              Int              @id @default(autoincrement())
  /// Type of interaction
  interactionType String
  /// Duration in minutes
  duration        Int
  /// Bonding change (-10 to +10)
  bondingChange   Int              @default(0)
  /// Quality of interaction
  quality         String           @default("good")
  /// Notes
  notes           String?
  /// Cost
  cost            Decimal          @default(0.0) @db.Decimal(10, 2)
  /// Task type for milestone evaluation
  taskType        String?
  /// Quality score for milestone evaluation (0.0-1.0)
  qualityScore    Float?           @default(0.75)
  /// Milestone window identifier for grouping interactions
  milestoneWindowId String?
  /// 31D-4: Temperament-groom synergy modifier applied to this interaction (e.g. 0.25 = +25%, -0.15 = -15%)
  synergyModifier Float?           @default(0)
  /// Foreign keys
  foalId          Int
  groomId         Int
  assignmentId    Int?
  /// Timestamps
  timestamp       DateTime         @default(now())
  createdAt       DateTime         @default(now())
  assignment      GroomAssignment? @relation(fields: [assignmentId], references: [id])
  foal            Horse            @relation(fields: [foalId], references: [id], onDelete: Cascade)
  groom           Groom            @relation(fields: [groomId], references: [id], onDelete: Cascade)

  /// Equoria-cmw85.25: daily care and milestone checks read one foal's interactions in a
  /// time range. Replaces the plain [foalId] index, which this one covers.
  @@index([foalId, timestamp])
  @@index([groomId])
  @@map("groom_interactions")
}

model Show {
  /// Unique identifier for each show
  id                 Int                 @id @default(autoincrement())
  /// Name of the show
  name               String              @unique
  /// Discipline
  discipline         String
  /// Level requirements
  levelMin           Int
  levelMax           Int
  /// Financial details
  entryFee           Int
  prize              Int
  /// Schedule
  runDate            DateTime
  /// Host user
  hostUserId         String?
  /// Show lifecycle status (BA-1)
  status             ShowStatus          @default(open)
  /// When the show was opened for entries (BA-1)
  openDate           DateTime?
  /// When the show stops accepting entries — openDate + 7 days (BA-1)
  closeDate          DateTime?
  /// When the overnight execution completed (BA-1)
  executedAt         DateTime?
  /// Timestamp when show transitions to 'executing' state (Equoria-c7mx0)
  /// Used by crash-recovery reaper to detect shows stuck mid-execution for >2h
  claimedAt          DateTime?
  /// Equoria-c7mx0 (2026-07-06 approved decision): the scored ordering,
  /// persisted in the SAME atomic statement as the 'executing' claim. Array of
  /// { horseId, userId, horseName, score, placement, riderId } — the payout
  /// phase is a pure replay of this array, so crash recovery pays exactly the
  /// placements scored at claim time (never a re-roll). Cleared (with
  /// claimedAt) on every terminal write.
  stagedOrdering     Json?
  /// Equoria-c7mx0.1 (owner ruling 2026-10-23): failed execution attempts
  /// counted by the show-execution reaper; at 3 the show is 'quarantined'.
  executionAttempts  Int                 @default(0)
  /// User who created this show (BA-1)
  createdByUserId    String?
  /// Club that created this show (BA-1)
  createdByClubId    Int?
  /// Optional description (BA-2)
  description        String?
  /// Max entries allowed (BA-2)
  maxEntries         Int?
  /// Show type: 'ridden' (default discipline scoring), 'conformation', or 'parade' (presentation scoring)
  showType           String              @default("ridden")
  /// Equoria-si69u: per-show escrow accounting columns. prizeEscrow tracks
  /// the prize-side money held by SystemAccount[showEscrow] for this show;
  /// feeEscrow tracks the entry-fee-side money held for this show. Both
  /// decrement to zero by execute time. The aggregate
  /// SystemAccount[showEscrow].balance MUST equal
  /// SUM(prizeEscrow + feeEscrow) across all open shows at all times —
  /// reconciled by the money-conservation sentinel in
  /// `backend/__tests__/showEscrowMoneyConservation.integration.test.mjs`.
  prizeEscrow        Int                 @default(0)
  feeEscrow          Int                 @default(0)
  /// Timestamps
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  competitionResults CompetitionResult[]
  entries            ShowEntry[]
  hostUser           User?               @relation(fields: [hostUserId], references: [id])
  createdByUser      User?               @relation("ShowCreator", fields: [createdByUserId], references: [id])

  /// Equoria-cmw85.26: the browse page filters on status and sorts by runDate; the
  /// dashboard's upcoming shows filter on runDate alone. [status, runDate] replaces the
  /// plain [status] index it covers.
  @@index([status, runDate])
  @@index([runDate])
  @@index([closeDate])
  /// Equoria-c7mx0: serves the show-execution reaper's stale-'executing'
  /// scan. `map` pins the name the migration created so `prisma migrate dev`
  /// does not generate a rename/drop.
  @@index([status, claimedAt], map: "shows_status_claimed_at_idx")
  /// Equoria-bvddn.23: FK index for "shows I created" lookups.
  @@index([createdByUserId])
  @@map("shows")
}

/// Equoria-si69u: named system-money accounts. Each row is a named
/// counterparty for money entering or leaving "the system" — what makes
/// money conservation a provable invariant rather than something the
/// codebase informally maintains.
///
/// Seed (in the migration):
///   - `showEscrow`: holds prize + accumulated entry fees for open shows
///   - `burn`:        terminal account; money credited here is permanently
///                    removed from circulation (used when a show's creator
///                    has been GDPR-deleted before payout)
///
/// All mutations on `balance` MUST go through `creditSystemAccount` /
/// `debitSystemAccountOrThrow` in `backend/services/financialLedgerService.mjs`
/// so the `UserTransaction` ledger has a paired row for every system-money
/// move. Bypassing those helpers breaks the audit trail and the
/// money-conservation sentinel will fail.
model SystemAccount {
  /// Stable name used as the primary key. Hardcoded constants live in
  /// `backend/services/financialLedgerService.mjs`.
  name      String   @id
  /// Current balance. Mutated only through the helper functions.
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  /// Equoria-mxftz / Equoria-69gip: the `@default(now())` here DESCRIBES the
  /// column migration
  /// 20260529120000_si69u_add_show_escrow_columns_and_system_accounts already
  /// created — `NOT NULL DEFAULT CURRENT_TIMESTAMP`. Without it Prisma sees the
  /// database default as stray and proposes
  /// `ALTER TABLE "system_accounts" ALTER COLUMN "updatedAt" DROP DEFAULT`
  /// (measured 2026-09-08, re-measured 2026-09-09). Declaring it makes that
  /// statement stop being generated, and it needs no migration because the
  /// database already has the default — the schema is being brought into line
  /// with reality, not the other way round. This is the single NON-INDEX item in
  /// the Equoria-69gip set; owner ruling 2026-09-09 was to keep it, on the
  /// grounds that leaving it out would return that one `ALTER COLUMN` to the
  /// proposal and defeat the point of the task.
  ///
  /// `@updatedAt` continues to maintain the value on every Prisma-client write;
  /// the database default only ever covers a raw INSERT that omits the column.
  /// Verified: no backend code raw-INSERTs into this table (the only
  /// `INSERT INTO "system_accounts"` in the tree is inside that migration, and it
  /// supplies `updatedAt` explicitly). Do NOT accept the DROP DEFAULT if some
  /// future proposal offers it: the column stays `NOT NULL`, so afterwards any
  /// raw seed or `$executeRaw` that omits `updatedAt` would fail instead of
  /// defaulting, and the churn buys nothing.
  updatedAt DateTime @updatedAt @default(now())

  @@map("system_accounts")
}

model CompetitionResult {
  /// Unique identifier for each result
  id         Int      @id @default(autoincrement())
  /// Competition details
  score      Decimal  @db.Decimal(10, 2)
  /// The 1-based rank (1 = winner); NULL when the result records no placing.
  /// An integer since Equoria-f46tb (owner ruling 2026-10-22): it was a string
  /// written both as '1' and as '1st'.
  placement  Int?
  discipline String
  runDate    DateTime
  showName   String
  /// Rewards
  prizeWon   Decimal? @default(0) @db.Decimal(10, 2)
  /// Ridden shows: the post-show stat gain the horse really received,
  /// `{ stat, gain }`, or NULL when none. Conformation shows: `{ ribbon,
  /// titlePoints }`. Written by competitionResultRecord.mjs (owner ruling R6,
  /// 2026-10-15, Equoria-q4uem.10).
  statGains  Json?
  /// Horse Points the placement awarded, recorded at settlement so history is
  /// never recomputed from today's award table (owner ruling R6). NULL on rows
  /// settled before Equoria-q4uem.10 and on conformation results, which award
  /// no Horse Points today.
  horsePointsAwarded Int?
  /// Equoria-4q02c (owner ruling q01, 2026-10-23): every input of the score for
  /// a ridden entry, `{ base, trainingPoints, tackPoints, luckPercent,
  /// riderPercent, temperamentPercent, healthPercent }`, written at settlement
  /// from the staged ordering. Visible ONLY to the Owner and Admins (staff
  /// capability results.scoreInputs.view); never a player or moderator surface,
  /// so every player-facing read selects columns or omits this one. NULL on
  /// rows settled before this column and on conformation results.
  scoreInputs Json?
  /// Foreign keys
  horseId    Int
  showId     Int
  /// The player who entered the horse in the show (Equoria-r9q06, owner ruling
  /// q256, 2026-10-28): when a horse is sold, its past results stay in the
  /// totals of the player who entered them, so player records read this column,
  /// never the horse's current owner. Written at settlement from the entry;
  /// existing rows were backfilled from their show entry, else the horse's
  /// owner at migration time. NULL only after that player's account is erased.
  entrantUserId String?
  /// Timestamps
  createdAt  DateTime @default(now())
  /// When the owning player opened this result (Equoria-oey96.28, owner ruling
  /// 2026-09-21). NULL means the player has not seen it yet, which is the only
  /// real source for the Story 23.4 `check-results` next-action: without this
  /// column "results available, not yet viewed" cannot be sourced at all.
  ///
  /// Written ONLY by the ownership-scoped mark-viewed path
  /// (`markUserResultsViewed` in
  /// backend/modules/competition/services/resultModelService.mjs, behind
  /// POST /api/v1/competition/results/viewed). Nothing else sets it, and it is
  /// never cleared — viewing a result is a one-way latch.
  ///
  /// Rows that existed before the migration were backfilled to the migration
  /// timestamp, so the hub only ever nudges a player about results produced
  /// after deployment. See the migration header for the reasoning.
  viewedAt   DateTime?
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  show       Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  entrant    User?    @relation("CompetitionResultEntrant", fields: [entrantUserId], references: [id], onDelete: SetNull)

  @@unique([showId, horseId])
  /// Equoria-r9q06: a player's results, newest first (stats, prize history, My Results).
  @@index([entrantUserId, runDate(sort: Desc)])
  @@index([horseId, score])
  /// Serves the check-results read on every Hub load: the unviewed-results
  /// lookup filters `horseId IN (<the player's horses>) AND "viewedAt" IS NULL`,
  /// which this index answers directly. `[horseId, score]` above cannot: its
  /// second column is the wrong one, so that index leaves the `viewedAt`
