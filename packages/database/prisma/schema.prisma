/// Durable outgoing email (STAFF-CR-10). A row is written in the same
/// transaction as the event it announces and delivered by the email-outbox
/// worker, which retries with backoff and ends a row as `failed` after its
/// last attempt. A recipient's rows go when the account is deleted.
model EmailOutbox {
  id             Int       @id @default(autoincrement())
  /// One row per event and recipient, e.g. "staffTicket:<ticketId>:<userId>".
  idempotencyKey String    @unique
  recipientId    String
  recipient      User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  templateKey    String // staffTicket
  payload        Json
  status         String    @default("pending") // pending | sending | sent | failed | cancelled
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  /// When the current attempt was claimed; a claim older than the lease is retaken.
  claimedAt      DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  // Retention purge: settled rows by status and age (STAFF-CR-10 review).
  @@index([status, updatedAt])
  @@index([recipientId])
  @@map("email_outbox")
}

/// Equoria-q4uem.9 — kind of breeding a BreedingRecord describes.
enum BreedingKind {
  OWN_PAIR
  PUBLIC_STUD
  PRIVATE_STUD
}

/// Equoria-q4uem.9 — PENDING exists only for a PRIVATE_STUD request awaiting
/// the stallion owner; every other breeding is written COMPLETED.
enum BreedingStatus {
  PENDING
  COMPLETED
  DECLINED
  CANCELLED
}

/// Equoria-q4uem.9 — one row per breeding (owner ruling S-Q7, Stacey
/// 2026-10-16): the breeding itself and the stud fee paid (0 for a pair the
/// player owns). No other "terms". A PRIVATE_STUD request starts PENDING (the
/// stallion owner's queue) and becomes COMPLETED, DECLINED or CANCELLED.
///
/// FKs are nullable with onDelete: SetNull (GDPR erasure hard-deletes horses
/// and users); the name snapshots keep the counterparty's record readable.
///
/// One PENDING row per dam (S7) is enforced by the PARTIAL unique index
/// "breeding_records_one_pending_per_dam" (WHERE status = 'PENDING'), created
/// in raw SQL by migration 20261016120000_q4uem9_breeding_records — Prisma
/// cannot express a partial index (see the kccmt note on Horse).
model BreedingRecord {
  id                Int            @id @default(autoincrement())
  kind              BreedingKind
  status            BreedingStatus
  /// Stud fee paid (or pinned while PENDING), in coins. 0 for OWN_PAIR.
  fee               Int
  sireId            Int?
  sire              Horse?         @relation("BreedingRecordSire", fields: [sireId], references: [id], onDelete: SetNull)
  damId             Int?
  dam               Horse?         @relation("BreedingRecordDam", fields: [damId], references: [id], onDelete: SetNull)
  /// Equoria-wnlf0 (BRE-11): the foal this breeding produced, set in the foaling
  /// transaction. Null until the birth (and for PENDING/DECLINED/CANCELLED rows).
  foalId            Int?           @unique
  foal              Horse?         @relation("BreedingRecordFoal", fields: [foalId], references: [id], onDelete: SetNull)
  mareOwnerId       String?
  mareOwner         User?          @relation("BreedingRecordsAsMareOwner", fields: [mareOwnerId], references: [id], onDelete: SetNull)
  stallionOwnerId   String?
  stallionOwner     User?          @relation("BreedingRecordsAsStallionOwner", fields: [stallionOwnerId], references: [id], onDelete: SetNull)
  sireName          String
  damName           String
  mareOwnerName     String
  stallionOwnerName String
  /// Request outcome only (DECLINED / CANCELLED).
  declineReason     String?
  createdAt         DateTime       @default(now())
  resolvedAt        DateTime?

  @@index([stallionOwnerId, status])
  @@index([mareOwnerId, status])
  @@index([damId, status])
  @@index([sireId, status])
  @@map("breeding_records")
}

/// Equoria-wbt8l — one entry on the News page (owner rulings 2026-10-23,
/// Stacey). Two kinds of writer:
///   - the owner (Head Admin) or an Admin, at the News Desk: postType
///     seasonalEvent, headAdminLetter (an announcement), contest or store;
///   - the game, at the start of each Eastern game day: postType
///     electionOpened, runoffResult, newStoreItem or seasonalEventStarted.
/// postType is a plain string checked by backend/modules/news (a new post
/// type needs no migration). A row is visible to players from publishAt on;
/// a seasonal event is written ahead and publishes at the start of the 1st.
model NewsItem {
  id              Int       @id @default(autoincrement())
  postType        String
  title           String
  body            String
  /// Image tiles under a seasonal event: [{ imageUrl, caption }]; [] otherwise.
  tiles           Json      @default("[]")
  /// The staff account that wrote it; null for game entries, and SetNull if
  /// the account is erased (the snapshots below keep the signature readable).
  authorUserId    String?
  author          User?     @relation("NewsItemAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  /// Signature snapshot at posting time: the author's username and staff
  /// level ("Head Admin", "Admin"). Null for game entries.
  authorName      String?
  authorRoleLabel String?
  /// In-game path a game entry links to (a club, a shop). Null when none.
  linkPath        String?
  /// When what the post announces ends (polls close, contest entries close,
  /// the month's event ends). Shown under "Ahead" while it is in the future.
  endsAt          DateTime?
  /// Game entries only: what the entry announces, e.g. "electionOpened:42".
  /// Unique, so a re-run of the nightly job never posts the same thing twice.
  sourceKey       String?   @unique
  publishAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishAt(sort: Desc), id(sort: Desc)])
  @@index([endsAt])
  @@index([authorUserId])
  @@map("news_items")
}

/// Equoria-w47x7 (owner ruling q77, 2026-10-26): a player's conduct record. One row
/// per steward action on the account: a warning, a freeze (1, 3 or 7 days, ending
/// at endsAt) or an account ban. A freeze is active while endsAt is in the future;
/// a ban is active forever (no lifting yet). issuedById has no foreign key, like
/// StaffActionLog, so erasing a steward keeps the record. Every row is paired with
/// a staff_action_log entry written in the same transaction.
model ConductRecord {
  id           Int       @id @default(autoincrement())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // warning | freeze | ban
  reason       String
  issuedById   String
  issuedByRole String
  /// Freezes only: the length chosen (1, 3 or 7) and the moment it ends.
  freezeDays   Int?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, kind])
  @@map("conduct_records")
}

/// Equoria-w47x7: where an account has signed in from, so a steward's IP or device
/// ban can name the connection. ipAddress is the request IP; deviceHash is the
/// SHA-256 of the first-party equoriaDevice cookie the game itself issues (nothing
/// is sent to any third party). One row per account, address and device, with the
/// first and last time seen. Removed with the account.
model LoginSighting {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String   @db.VarChar(45)
  deviceHash  String   @db.VarChar(64)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, ipAddress, deviceHash])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@map("login_sightings")
}

/// Equoria-w47x7: an IP or device ban. A banned IP or device cannot sign in or sign
/// up. value is the IP address or the device hash. sourceUserId is the account the
/// steward banned it through; no foreign key, so the ban outlives that account.
model ConductBlock {
  id           Int      @id @default(autoincrement())
  kind         String // ip | device
  value        String   @db.VarChar(64)
  reason       String
  issuedById   String
  issuedByRole String
  sourceUserId String?
  createdAt    DateTime @default(now())

  @@unique([kind, value])
  @@map("conduct_blocks")
}

/// Equoria-vc5x1: when an account last made an authenticated request, stamped at
/// most once a minute by authenticateToken. Backs the Need Help? online status.
/// Its own table with NO relation to User on purpose: the stamp must never take
/// a lock on the User row (an FK insert takes FOR KEY SHARE on the parent) or
/// write to it, so it cannot interfere with player-state transactions.
model UserPresence {
  userId       String   @id
  lastActiveAt DateTime

  @@map("user_presence")
}

/// Equoria-y3nia (owner rulings q42, 2026-10-23): the Monthly leaderboards read
/// these totals; the Overall boards are counted live. One row per player per
/// game month per category, added to inside the transaction that earns the
/// amount (a show settling, an XP award), so a rolled-back settlement leaves no
/// trace and a duplicate settlement is refused before it can be counted twice.
/// `month` is the Eastern game month, 'YYYY-MM' (backend/utils/gameTime.mjs).
/// Categories: xp, earnings, wins, shows.
model PlayerMonthlyTotal {
  id       Int    @id @default(autoincrement())
  month    String
  category String
  playerId String
  value    Int    @default(0)
  player   User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([month, category, playerId])
  @@index([month, category, value(sort: Desc), playerId])
  @@index([playerId])
  @@map("player_monthly_totals")
}

/// Equoria-y3nia: the horse side of PlayerMonthlyTotal. Categories: points
/// (Horse Points earned), earnings, wins, shows, and one 'disciplineWins:<name>'
/// per discipline (first places in that discipline, the per-discipline boards).
model HorseMonthlyTotal {
  id       Int    @id @default(autoincrement())
  month    String
  category String
  horseId  Int
  value    Int    @default(0)
  horse    Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([month, category, horseId])
  @@index([month, category, value(sort: Desc), horseId])
  @@index([horseId])
  @@map("horse_monthly_totals")
}

/// Hall of Fame (Equoria-vb1n0, owner rulings 2026-10-28, q257-q259). The Hall
/// of Fame is for the best of the best, not every retired horse: an owner
/// nominates a retired horse (21+) once, ever; that week's nominations are the
/// next Eastern week's nominees; every player has one vote per round and may
/// vote for any nominee, her own included; the round's top horse is inducted.
/// A tied top vote opens a one-game-day run-off between the tied horses, like
/// club elections, repeating until one wins. A horse that is not inducted has
/// used its one chance. The Hall of Fame started empty.
enum HallOfFameRoundOutcome {
  /// One nominee had the most votes; inductedHorseId was inducted.
  inducted
  /// The top vote count was tied; `runoff` is the round deciding it.
  runoff
  /// No votes were cast (or the round had no nominees): nobody was inducted.
  none
}

/// One nomination: a horse can be nominated once, ever (horseId is unique).
model HallOfFameNomination {
  id            Int      @id @default(autoincrement())
  horseId       Int      @unique
  horse         Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  nominatedById String
  nominatedBy   User     @relation("HallOfFameNominations", fields: [nominatedById], references: [id], onDelete: Cascade)
  /// 00:00 Eastern on the Sunday that starts the game week (owner ruling q265) the nomination was made in;
  /// the horse is a nominee in the round of the following week.
  weekStart     DateTime
  createdAt     DateTime @default(now())
  candidacies   HallOfFameCandidate[]

  @@index([weekStart])
}

/// A voting round: the weekly round, or a one-day run-off of a tied round.
model HallOfFameRound {
  id              Int                     @id @default(autoincrement())
  /// The game week a weekly round belongs to (00:00 Eastern Sunday); NULL for a run-off.
  weekStart       DateTime?               @unique
  startsAt        DateTime
  endsAt          DateTime
  /// Set when the closing job decides the round; NULL while it is open.
  closedAt        DateTime?
  outcome         HallOfFameRoundOutcome?
  /// A run-off round points at the tied round it decides.
  runoffOfId      Int?                    @unique
  runoffOf        HallOfFameRound?        @relation("HallOfFameRunoff", fields: [runoffOfId], references: [id], onDelete: SetNull)
  runoff          HallOfFameRound?        @relation("HallOfFameRunoff")
  candidates      HallOfFameCandidate[]
  votes           HallOfFameVote[]
  induction       HallOfFameInduction?

  @@index([closedAt, endsAt])
}

/// A nominated horse standing in one round.
model HallOfFameCandidate {
  id           Int                  @id @default(autoincrement())
  roundId      Int
  round        HallOfFameRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  nominationId Int
  nomination   HallOfFameNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  votes        HallOfFameVote[]

  @@unique([roundId, nominationId])
  @@index([nominationId])
}

/// One player's one vote in one round.
model HallOfFameVote {
  id          Int                 @id @default(autoincrement())
  roundId     Int
  round       HallOfFameRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidateId Int
  candidate   HallOfFameCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterId     String
  voter       User                @relation("HallOfFameVotes", fields: [voterId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@unique([roundId, voterId])
  @@index([candidateId])
  @@index([voterId])
}

/// A horse in the Hall of Fame, with the date it joined.
model HallOfFameInduction {
  id         Int             @id @default(autoincrement())
  horseId    Int             @unique
  horse      Horse           @relation(fields: [horseId], references: [id], onDelete: Cascade)
  roundId    Int             @unique
  round      HallOfFameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  inductedAt DateTime
}
