  // Set when a password, email or role change cancels the code (q261, Equoria-8pzlg):
  // a retired code never checks in, whatever the clock says.
  retiredAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  // Retention purge (STAFF-CR-18): used or expired more than 1 day ago.
  @@index([usedAt])
  @@index([expiresAt])
  @@map("staff_checkin_codes")
}

model StaffTrustedDevice {
