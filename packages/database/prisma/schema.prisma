  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'groom' | 'rider' | 'trainer'
  staffType    String
  /// JSON array of currently available staff offers
  offers       Json     @default("[]")
  lastRefresh  DateTime @default(now())
  refreshCount Int      @default(0)

  @@unique([userId, staffType])
  @@map("staff_marketplace_state")
}

// ── BB-1: Foal age stage enum ──────────────────────────────────────────────────

enum AgeStage {
  // Game-year clock (7 real days = 1 game year; Equoria-oey96.16). Boundaries
  // in real days — graduation (age 3 game-years / 21 real days) is the stage=null
  // case, computed live by backend/utils/foalAgeUtils.mjs (not persisted here).
  newborn       // 0-2 real days   (game-year 0, early)
  weanling      // 3-6 real days   (game-year 0, late)
  yearling      // 7-13 real days  (game-year 1)
  twoYearOld    // 14-20 real days (game-year 2)
}

// ── Equoria-9wby: Persistent CronRunLog ────────────────────────────────────────
// Cross-restart history of cron job executions. Complements the in-memory
// heartbeat (CronJobService.heartbeats) added in Equoria-0elk by giving
// /api/admin/cron/health a queryable last-N runs view per job that survives
// process restarts.
//
// Written by CronJobService.runWithHeartbeat() on every cycle (success + error)
// — one row per cycle, status = 'success' | 'error'. Aggregated summary
// counters (horsesProcessed, birthdaysFound, etc.) come from each job
// handler's return payload via summarizeResult() — see backend/services/cronJobs.mjs.

model CronRunLog {
  id                    Int      @id @default(autoincrement())
  jobName               String
  startedAt             DateTime
  finishedAt            DateTime?
  /// 'success' | 'error' | 'skipped-locked' (Equoria-iot0h: skipped-locked is
  /// recorded when the replica lost a pg_try_advisory_xact_lock race and
  /// yielded to a peer replica that ran the side-effect).
  status                String
  horsesProcessed       Int?
  birthdaysFound        Int?
  milestonesEvaluated   Int?
  electionsOpened       Int?
  electionsClosed       Int?
  errorsCount           Int?
  errorMessage          String?
  /// Full handler summary payload as JSONB for forward-compat (new counters
  /// surface here without a schema change).
  summary               Json?
  createdAt             DateTime @default(now())

  @@index([jobName, startedAt(sort: Desc)])
  @@index([status])
  @@map("cron_run_logs")
}

// ── Equoria-jw10w: DB-backed security audit trail (OWASP A09) ──────────────────
// Tamper-evident, queryable, retained audit trail for sensitive mutating
// operations. `userId` is a SOFT reference (no FK relation) on purpose: audit
// records must survive user deletion for forensic/compliance reasons — a
// cascading delete would let an attacker erase their own trail by deleting
// their account. Written best-effort/fail-soft by storeAuditLog(); an audit
// write failure must never break the underlying request.
model AuditLog {
  id           Int      @id @default(autoincrement())
  /// Soft reference to User.id (uuid). Nullable for unauthenticated events
  /// (e.g. failed login). NOT a Prisma relation by design (see above).
  userId       String?
  /// Operation classifier, e.g. 'authentication', 'transaction', 'breeding',
  /// 'training', 'adminOperation', or 'mutation' for the generic global path.
  action       String
  /// Logical resource touched, derived from the request path's first segment.
  resource     String?
  /// Resource identifier when the route carries one (best-effort).
  resourceId   String?
  method       String
  path         String
  statusCode   Int
  ip           String?
  userAgent    String?
  /// true when statusCode < 400.
  success      Boolean
  /// Sanitized request context (body/params/query with secrets redacted).
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ── Equoria-zr9kl: persisted API-documentation coverage snapshots ──────────────
// Each row is a point-in-time snapshot of the OpenAPI documentation coverage
// metrics. Persisting a series of these is what lets the /api/docs/analytics
// route compute a REAL coverage/quality trend (improving / declining / stable)
// instead of the honest not-tracked placeholder it returns when fewer than two
// snapshots exist. Snapshots are recorded via
// apiDocumentationService.recordCoverageSnapshot(); the recording cadence
// (scheduled cron) is a deferred follow-up — the persistence model + the
// derive-trend-from-history function are the in-scope slice.
model DocCoverageSnapshot {
  id                  Int      @id @default(autoincrement())
  /// When the snapshot was captured.
  capturedAt          DateTime @default(now())
  /// Documentation coverage percentage (0–100) at capture time.
  coveragePct         Float
  /// Computed quality score (0–100) at capture time.
  qualityScore        Int
  /// Total endpoints present in the spec at capture time.
  totalEndpoints      Int
  /// Endpoints considered fully documented at capture time.
  documentedEndpoints Int

  @@index([capturedAt(sort: Desc)])
  @@map("doc_coverage_snapshots")
}

/// Permanent staff action log: rows are never deleted. actorId is the acting
/// account's ID with no foreign key, so erasing that account keeps its entries
/// (Equoria-2yugk).
model StaffActionLog {
  id         Int             @id @default(autoincrement())
  actorId    String
  actorRole  String
  capability String
  targetType String
  targetId   String?
  reason     String?
  before     Json?
  after      Json?
  outcome    String // succeeded | failed
  error      String?
  reversesId Int?            @unique
  reverses   StaffActionLog? @relation("StaffActionReversal", fields: [reversesId], references: [id])
  reversedBy StaffActionLog? @relation("StaffActionReversal")
  createdAt  DateTime        @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([capability])
  @@map("staff_action_log")
}

model StaffCheckinCode {
