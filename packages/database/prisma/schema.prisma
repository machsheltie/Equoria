  /// entry presents the horse at settlement, whatever the assignment says by
  /// then. Null for ridden entries.
  groomId   Int?
  groom     Groom?   @relation(fields: [groomId], references: [id], onDelete: SetNull)
  /// The groom's scoring fields as entered ({ id, name, showHandlingSkill,
  /// personality }); settlement scores with it only if the groom row was deleted.
  groomSnapshot Json?
  createdAt DateTime @default(now())

  @@unique([showId, horseId])
  @@index([horseId])
  @@index([userId])
  @@index([groomId])
