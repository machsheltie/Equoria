  /// Personality type (daring | methodical | intuitive | competitive)
  personality  String
  /// Skill level (rookie | developing | experienced)
  skillLevel   String
  /// Star level (owner ruling 2026-10-28, Equoria-nawn5): rookie | novice | intermediate |
  /// advanced | expert (1-5 stars). Drawn once when the game generates the rider; the
  /// price comes from it (backend/constants/staffLevels.mjs). The allowed words are a CHECK
  /// constraint in migration 20261028120000_staff_star_levels.
  starLevel    String            @default("rookie")
  /// Preferred discipline specialty
  speciality   String
  /// Weekly rate in game currency: always the star level's price (owner ruling
  /// 2026-10-28, q226; migration 20261028180000_staff_level_is_stars).
  weeklyRate   Int               @default(200)
  /// Total XP accumulated
  experience   Int               @default(0)
  /// Career weeks accumulated
  careerWeeks  Int               @default(0)
  /// Age in game-years when the rider was generated (18-25, owner ruling
  /// 2026-10-23, Equoria-or2ua). Age = startAge + careerWeeks. Null only for
  /// riders that predate the ruling and have not been backfilled.
  startAge     Int?
  /// Total competition wins
  totalWins         Int               @default(0)
  /// Total competition entries (incremented at show execution)
  totalCompetitions Int               @default(0)
  /// Prestige score (0–100)
  prestige     Int               @default(0)
  /// Retirement status
  retired      Boolean           @default(false)
  /// Owner ruling 2026-10-27 (q111): the Eastern Monday (pay week) whose weekly pay this
  /// rider went unpaid. NULL = paid up. While set the rider cannot ride; a full pay week
  /// later, still unpaid, the rider leaves. Mirrors Groom.feeUnpaidSince.
  feeUnpaidSince DateTime?
  /// Owner ruling 2026-10-28 (q177, Equoria-xlw03): a dismissed or unpaid rider returns to
  /// the riders-for-hire pool at its current level with its reveals intact. Set when the
  /// rider enters the pool (userId is cleared at the same time); cleared when hired again.
  /// The pool is userId NULL, retired false, freeAgentSince NOT NULL.
  freeAgentSince DateTime?
  /// Biography
  bio          String?
  /// User association
  userId       String?
  /// Timestamps
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  RiderAssignment[]
  user         User?             @relation(fields: [userId], references: [id])
  /// The HIDDEN retirement age lives in its own table so no rider read can
  /// serialise it (see RiderRetirementSchedule).
  riderRetirementSchedule RiderRetirementSchedule?
  /// The rider's hidden growth profile (Equoria-xlw03): its own table, like the
  /// retirement schedule, so no rider read can serialise the unrevealed items.
  growthProfile RiderGrowthProfile?
  salaryPayments RiderSalaryPayment[]

  /// Equoria-cmw85.25: the roster pages and the weekly retirement job. Each replaces a
  /// plain single-column index (userId, retired) that it covers.
  @@index([userId, retired])
  @@index([retired, careerWeeks])
  @@map("riders")
}

/// The game's HIDDEN per-rider retirement age (owner ruling 2026-10-23,
/// Equoria-or2ua). Rolled once, uniformly from [40, 65], when the rider is
/// generated; never recomputed, never returned by any API, never derivable.
/// A separate table, not a column on `riders`, for the same reason as
/// GroomRetirementSchedule: rider rows are serialised into player-facing
/// responses and a scalar column would leak. Only riderRetirementService.mjs and
/// the backfill service read it. The range is also enforced by a CHECK
/// constraint in migration 20261023220000_farrier_one_action_rider_retirement
/// (Prisma cannot express CHECK constraints; do not "restore" it here).
model RiderRetirementSchedule {
  /// One schedule per rider; the rider id IS the primary key.
  riderId       Int       @id
  /// The age (game-years) at which the game retires this rider.
  retirementAge Int
  /// When the one-week retirement notice was sent (null until it is). Claimed
  /// with a guarded update so the notice is sent exactly once.
  noticeSentAt  DateTime?
  /// When the schedule was rolled.
  assignedAt    DateTime  @default(now())

  rider         Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_retirement_schedules")
}

/// A rider's hidden growth profile (owner rulings 2026-10-28, q160/q177/q244; Equoria-xlw03).
/// `items` holds the twelve hidden modifiers drawn when the profile is made: 4 horse traits,
/// 4 disciplines and 2 temperaments (each positive or negative) and 2 favourite breeds
/// (positive), each with its own `revealed` flag. Rookies reveal nothing; each level-up
/// reveals 3 at random; Expert reveals all. `showsAtLevel` counts shows completed since the
/// last level-up (backend/constants/staffGrowth.mjs). Players only ever see revealed items.
model RiderGrowthProfile {
  riderId      Int      @id
  items        Json     @default("[]")
  showsAtLevel Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rider        Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_growth_profiles")
}

/// A groom's hidden growth profile: the same shape as RiderGrowthProfile (Equoria-xlw03).
model GroomGrowthProfile {
  groomId      Int      @id
  items        Json     @default("[]")
  showsAtLevel Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  groom        Groom    @relation(fields: [groomId], references: [id], onDelete: Cascade)

  @@map("groom_growth_profiles")
}

/// The weekly pay of a hired rider, one row per rider per pay week (owner ruling
/// 2026-10-27, q111). weekKey is the Eastern (game-clock) Monday that starts the pay week
/// as 'YYYY-MM-DD'. The database holds at most ONE 'paid' row per (riderId, weekKey): a
/// partial unique index that exists only in migration SQL. Rows that record a missed week
/// are not limited.
model RiderSalaryPayment {
  id          Int      @id @default(autoincrement())
  riderId     Int
  userId      String
  /// The rider's weekly rate charged (or missed) for that week
  amount      Int
  weekKey     String
  /// paid, missed (the week went unpaid), or releasedNonPayment (the rider left)
  status      String   @default("paid")
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([userId, weekKey])
  @@map("rider_salary_payments")
}

model RiderAssignment {
  /// Unique identifier for each assignment
  id        Int      @id @default(autoincrement())
  /// Assignment status
  isActive  Boolean  @default(true)
  /// Optional notes
  notes     String?
  /// When assignment started
  startDate DateTime @default(now())
  /// Foreign keys
  riderId   Int
  horseId   Int
  userId    String?
  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  /// Equoria-kccmt: the one-active-assignment-per-(rider, horse) rule is a
  /// PARTIAL unique index — `rider_assignments_active_riderId_horseId_key ...
  /// WHERE "isActive"` — created in raw SQL by migration
  /// 20260907120000_kccmt_partial_unique_active_staff_assignments. Prisma
  /// cannot express a partial index, so it is deliberately absent here; the
  /// former `@@unique([riderId, horseId, isActive])` also capped assignment
  /// HISTORY at one inactive row per pair, which broke re-assignment and forced
  /// the sale path to delete history. Do not "restore" it.
  @@index([riderId])
  @@index([horseId])
  @@index([userId])
  @@map("rider_assignments")
}

model Trainer {
  /// Unique identifier for each trainer
  id           Int                 @id @default(autoincrement())
  /// First name
  firstName    String
  /// Last name
  lastName     String
  /// Personality type (focused | encouraging | technical | competitive | patient)
  personality  String
  /// Skill level (novice | developing | expert)
  skillLevel   String
  /// Star level (owner ruling 2026-10-28, Equoria-nawn5): rookie | novice | intermediate |
  /// advanced | expert (1-5 stars). Drawn once when the game generates the trainer; the
  /// price comes from it (backend/constants/staffLevels.mjs). The allowed words are a CHECK
  /// constraint in migration 20261028120000_staff_star_levels.
  starLevel    String              @default("rookie")
  /// Preferred discipline specialty
  speciality   String
  /// Session rate in game currency: always the star level's price (owner ruling
  /// 2026-10-28, q226; migration 20261028180000_staff_level_is_stars).
  sessionRate  Int                 @default(150)
  /// Total XP accumulated
  experience   Int                 @default(0)
  /// Career weeks accumulated
  careerWeeks  Int                 @default(0)
  /// Retirement status
  retired      Boolean             @default(false)
  /// Biography
  bio          String?
  /// Discovery slot trait pool (3 categories × 2 slots = 6 entries).
  /// Persists generated career-affinity trait content. Visibility follows the
  /// stepped reveal cadence in backend/utils/discoverySlotReveal.mjs (Equoria-oey96.25),
  /// at the career level every trainer was generated with (1), since the old 1-10
  /// level was replaced by star levels (owner ruling 2026-10-28, q229).
  /// Backed by migration 20260513140000_add_trainer_discovery_slots.
  discoverySlots Json              @default("[]") @map("discovery_slots")
  /// User association
  userId       String?
  /// Timestamps
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignments  TrainerAssignment[]
  user         User?               @relation(fields: [userId], references: [id])

  @@index([userId, retired])
  @@index([retired, careerWeeks])
  @@map("trainers")
}

model TrainerAssignment {
  /// Unique identifier for each assignment
